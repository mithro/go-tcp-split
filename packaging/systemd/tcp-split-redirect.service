[Unit]
Description=tcp-split interception rules (nftables)
BindsTo=tcp-split.socket
After=tcp-split.socket
ConditionPathExists=/etc/tcp-split/redirect.nft

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/tcp-split/redirect.nft
ExecReload=/usr/sbin/nft -f /etc/tcp-split/redirect.nft
ExecStop=/usr/sbin/nft delete table inet tcp_split
